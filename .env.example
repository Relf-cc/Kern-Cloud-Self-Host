# ---- Kern self-hosted configuration (copy to .env) ----
#
# The addresses are already set for this instance (api.relf.cc and
# streams.relf.cc), so only the three secrets have to be generated:
# POSTGRES_PASSWORD, BETTER_AUTH_SECRET and STREAMS_ENCRYPTION_KEY.
#
#   openssl rand -hex 24       # POSTGRES_PASSWORD (hex: it goes in a URL)
#   openssl rand -base64 48    # BETTER_AUTH_SECRET
#   openssl rand -base64 32    # STREAMS_ENCRYPTION_KEY
#
# `cli/install.sh` writes this file for you with the secrets already generated.
# Running a different instance? Change PUBLIC_URL and STREAMS_URL to your own
# hostnames; everything else has a working default.

# ---------------------------------------------------------------- addresses

# The address people and apps use to reach this server, as they see it. Behind
# a reverse proxy this must be the public https:// origin, because sessions,
# invite links and share links are built from it.
PUBLIC_URL=https://api.relf.cc

# Serving invite links or stream endpoints from their own hostnames? Set these.
# Left empty they follow PUBLIC_URL, which is what a single-origin server wants.
#
# Stream endpoints and their phone capture pages are served on their own
# hostname, so the addresses handed to a form or a webhook never carry the API
# host. Both hostnames proxy to this one process: the split is in the URLs the
# server hands out, not in where it listens.
# LINK_URL=
STREAMS_URL=https://streams.relf.cc

# What this instance calls itself: in emails, on invite pages, in Kern Platform.
INSTANCE_NAME=Relf
# Who people should contact about this server (optional; shown in emails).
SUPPORT_EMAIL=admin@relf.cc

# ----------------------------------------------------------------- database

# docker compose builds DATABASE_URL from this; set DATABASE_URL yourself when
# running the API outside compose.
# Hex, not base64: docker compose puts this in DATABASE_URL, and a "/" in it
# makes that URL invalid (the API then fails to start with ERR_INVALID_URL).
#   openssl rand -hex 24
POSTGRES_PASSWORD=change-me-to-a-long-random-hex-string
# DATABASE_URL=postgres://kern:change-me@localhost:5432/kern

# ------------------------------------------------------------------ secrets

# Session signing secret: at least 32 random characters. Changing it signs
# everyone out.
#   openssl rand -base64 48
BETTER_AUTH_SECRET=

# Encrypts stream secrets, GitHub tokens and Turnstile keys (32 bytes, base64).
#   openssl rand -base64 32
# Back it up. If unset, a key is derived from BETTER_AUTH_SECRET, which means
# rotating that secret makes stored stream credentials unreadable.
STREAMS_ENCRYPTION_KEY=

# ------------------------------------------------------------- who may join

# open   | anyone who can reach the server may sign up
# invite | only an address holding a workspace invitation, or one an
#          administrator added (kernctl allow add)      <- the default
# closed | nobody new
# The very first account is always allowed, so you can start using a server
# you have just installed.
REGISTRATION=invite

# With REGISTRATION=open, optionally limit sign-ups to these email domains.
# ALLOWED_EMAIL_DOMAINS=relf.cc

# Accounts this instance will hold; 0 means no limit.
# MAX_USERS=0

# --------------------------------------------------------------- management

# The management API (/kern/v1/admin/*) that Kern Platform and kernctl use.
# Loopback-only by default: connect from the server's own machine, or forward
# the port over SSH (ssh -L 8787:127.0.0.1:8787 you@server).
ADMIN_LOCAL_ONLY=true
# Only read when ADMIN_LOCAL_ONLY=false. Addresses or IPv4 CIDR ranges.
# ADMIN_ALLOW_FROM=192.168.1.0/24

# Where the first management token is written on first start. Keep it readable
# only by the service account; kernctl reads it from here.
ADMIN_TOKEN_FILE=/var/lib/kern/admin-token
# Lines of server log the management API keeps in memory.
# ADMIN_LOG_LINES=2000

# --------------------------------------------------------------------- mail
#
# Without SMTP, verification codes and invitations are printed to the server
# log instead of sent. That works for a single-user instance (read the log, or
# use `kernctl users verify <email>`), but nobody else can finish signing up.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Kern <no-reply@relf.cc>

# Email to streams (optional): the shared secret the inbound email worker
# sends (server/deploy/email-worker.js) and the domain its addresses use.
# Leave the secret empty to turn the feature off.
INBOUND_EMAIL_SECRET=
INBOUND_EMAIL_DOMAIN=in.relf.cc

# ------------------------------------------------------------------ the app

# The URL scheme the desktop app registers, for invite links.
# APP_SCHEME=kern
# Where an invite link sends someone who hasn't got the app yet.
# DOWNLOAD_URL=https://github.com/kern-platform/kern/releases/latest
# Where your copy of the stream documentation lives, linked from rejections.
# STREAMS_DOCS_URL=https://github.com/Relf-cc/Kern-Cloud-Self-Host/blob/main/docs/streams.md

# Extra browser origins allowed to call the API. The desktop app's own origins
# are always allowed; add one only if you build your own client.
# EXTRA_CORS_ORIGINS=https://relf.cc

# ------------------------------------------------------------------- limits

# INVITE_EXPIRY_DAYS=14
# WORKSPACES_PER_USER=25
# MEMBERS_PER_WORKSPACE=200
# LOGO_MAX_BYTES=307200
# Shared whiteboard images: largest upload and total per space.
# ASSET_MAX_BYTES=3145728
# ASSET_QUOTA_MB=1024
# Streams: per space, largest submission, per-stream hourly ceiling, log retention.
# STREAMS_PER_SPACE=25
# STREAM_MAX_BODY_BYTES=262144
# STREAM_MAX_PER_HOUR=1000
# STREAM_LOG_MAX_DAYS=90
# STREAM_EMAIL_PER_HOUR=120
# Public share links and calendar feeds: turn the whole feature off with false.
# SHARES_ENABLED=true
# SHARE_MAX_CONTENT_BYTES=524288
# SHARE_MAX_IMAGE_BYTES=4194304
# SHARES_PER_USER=200
