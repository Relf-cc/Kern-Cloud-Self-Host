# --------------------------------------------------------- backup and restore
#
# A backup is a pg_dump. It runs where the database is: inside the compose
# project, or against DATABASE_URL on this machine.

cmd_backup() {
  detect_service
  out="${1:-kern-$(date +%Y%m%d-%H%M%S).sql.gz}"
  case "$SERVICE" in
    compose)
      say "Dumping the database from the compose project in $HOME_DIR…"
      compose exec -T db pg_dump -U kern -d kern --clean --if-exists | gzip > "$out"
      ;;
    *)
      need pg_dump
      [ -n "${DATABASE_URL:-}" ] || die "Set DATABASE_URL so pg_dump knows where to look." 2
      pg_dump "$DATABASE_URL" --clean --if-exists | gzip > "$out"
      ;;
  esac
  say "${C_OK}Wrote $out${C_OFF} ($(ls -lh "$out" | awk '{print $5}'))"
  say ""
  say "${C_DIM}Keep .env with it. Without BETTER_AUTH_SECRET and STREAMS_ENCRYPTION_KEY, a"
  say "restored dump can't decrypt stream credentials and everyone must sign in again.${C_OFF}"
}

cmd_restore() {
  [ $# -ge 1 ] || usage_error "$PROG restore <file.sql.gz>"
  file="$1"
  [ -r "$file" ] || die "Can't read $file." 2
  detect_service
  confirm "This replaces everything in the database with the contents of $file."
  case "$SERVICE" in
    compose)
      if [ "${file%.gz}" != "$file" ]; then
        gunzip -c "$file" | compose exec -T db psql -U kern -d kern -q
      else
        compose exec -T db psql -U kern -d kern -q < "$file"
      fi
      say "Restarting the API so it migrates and reloads its settings…"
      compose restart api
      ;;
    *)
      need psql
      [ -n "${DATABASE_URL:-}" ] || die "Set DATABASE_URL so psql knows where to look." 2
      if [ "${file%.gz}" != "$file" ]; then
        gunzip -c "$file" | psql "$DATABASE_URL" -q
      else
        psql "$DATABASE_URL" -q < "$file"
      fi
      ;;
  esac
  say "${C_OK}Restored.${C_OFF} Run \`$PROG heal\` to tidy up afterwards."
}

# ------------------------------------------------------------------------ use

cmd_use() {
  [ $# -ge 1 ] || usage_error "$PROG use <url> [--token kern_…]"
  new_url="$1"; shift
  new_token=""
  [ "${1:-}" = "--token" ] && new_token="${2:?--token needs a token}"
  mkdir -p "$(dirname "$USER_CONFIG")"
  {
    printf '# Written by kernctl use\n'
    printf 'KERN_URL=%s\n' "$new_url"
    [ -n "$new_token" ] && printf 'KERN_ADMIN_TOKEN=%s\n' "$new_token"
    [ -n "$CFG_HOME" ] && printf 'KERN_HOME=%s\n' "$CFG_HOME"
    [ -n "$CFG_SERVICE" ] && printf 'KERN_SERVICE=%s\n' "$CFG_SERVICE"
  } > "$USER_CONFIG"
  chmod 600 "$USER_CONFIG"
  say "${C_OK}kernctl now talks to $new_url.${C_OFF} ${C_DIM}($USER_CONFIG)${C_OFF}"
}

cmd_version() { printf '%s %s\n' "$PROG" "$VERSION"; }

cmd_help() {
  cat <<HELP
$PROG - manage a self-hosted Kern server

  Usage: $PROG [--url URL] [--token TOKEN] [--json] [--yes] <command>

Looking at it
  status                      what this instance is, and how much is in it
  health [--fix] [--fix=ID]   run every check; repair what can be repaired
  heal                        repair everything, then check again
  doctor                      this machine, and the path to the server
  logs [-f] [--level warn]    recent server log (in memory; empty after a restart)
  audit [N]                   what management tokens have done
  query "SELECT …"            a read-only look at the database

People
  users list [-q TEXT] [--held] [--unverified]
  users show <email|id>
  users hold <email> [reason]           suspend: no new sessions, data untouched
  users release <email>
  users verify <email>                  mark the address verified (no SMTP needed)
  users revoke-sessions <email>
  users delete <email> [--with-workspaces]
  allow list | add <email> [note] | remove <email>

Their work
  spaces list [-q TEXT] [--personal|--workspaces] [--deleted]
  spaces show <id>
  spaces delete <id> [--purge]
  invites list | revoke <id>
  streams list | enable <id> | disable <id>

The instance
  settings                    every setting, and where it comes from
  set <key> <value>           change one ("default" falls back to .env)
  notice "TEXT" [--warn]      tell everyone currently connected something
  token list | new "NAME" [--read] [--days N] | revoke <id>
