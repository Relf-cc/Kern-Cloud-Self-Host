#!/bin/sh
# kernctl - manage a self-hosted Kern server from a terminal.
#
# Everything Kern Platform can do, this can do: both speak the same management
# API (/kern/v1/admin/*), so a headless server is not a lesser citizen. On the
# server's own machine it needs no setup at all - it finds the management token
# where the server wrote it.
#
# POSIX sh and curl, nothing else required. Formatted tables use python3 when
# it is present; `--json` always works and needs neither, which is what you
# want in a script or a monitoring check.
#
# Configuration, in the order it is consulted:
#
#   --url / --token              on the command line
#   KERN_URL / KERN_ADMIN_TOKEN  in the environment
#   ~/.config/kernctl/config     written by `kernctl use`
#   /etc/kernctl/config          system-wide, written by the installer
#   the token file               ADMIN_TOKEN_FILE, or /var/lib/kern/admin-token
#   http://127.0.0.1:8787        the default address
#
# Exit codes: 0 fine, 1 refused by the server, 2 called wrongly, 3 could not
# reach the server, 4 health found a failure.

set -eu

VERSION="1.0.0"
PROG="$(basename "$0")"

DEFAULT_URL="http://127.0.0.1:8787"
USER_CONFIG="${XDG_CONFIG_HOME:-$HOME/.config}/kernctl/config"
SYSTEM_CONFIG="/etc/kernctl/config"
DEFAULT_TOKEN_FILE="/var/lib/kern/admin-token"

URL=""
TOKEN=""
JSON=0
YES=0
QUIET=0
API=""
ADMIN=""
BODY=""
CFG_URL=""
CFG_TOKEN=""
CFG_TOKEN_FILE=""
CFG_HOME=""
CFG_SERVICE=""

# --------------------------------------------------------------- foundations

if [ -t 1 ] && [ -z "${NO_COLOR:-}" ]; then
  C_DIM='\033[2m'; C_B='\033[1m'; C_OK='\033[32m'; C_WARN='\033[33m'; C_ERR='\033[31m'; C_OFF='\033[0m'
else
  C_DIM=''; C_B=''; C_OK=''; C_WARN=''; C_ERR=''; C_OFF=''
fi

say() { [ "$QUIET" = 1 ] || printf '%b\n' "$*"; }
warn() { printf '%b\n' "${C_WARN}$*${C_OFF}" >&2; }
die() { printf '%b\n' "${C_ERR}$1${C_OFF}" >&2; exit "${2:-1}"; }
usage_error() {
  printf '%b\n' "${C_ERR}$*${C_OFF}" >&2
  printf '%s\n' "Try: $PROG help" >&2
  exit 2
}
need() { command -v "$1" >/dev/null 2>&1 || die "$PROG needs $1, which isn't installed." 2; }
has_python() { command -v python3 >/dev/null 2>&1; }

# ------------------------------------------------------------- configuration

read_config_file() {
  [ -r "$1" ] || return 0
  # Only KERN_* assignments are read, and they are never executed: a stray
  # command in a config file must not run just because kernctl started.
  while IFS='=' read -r key value; do
    case "$key" in
      KERN_URL) [ -z "$CFG_URL" ] && CFG_URL="$value" ;;
      KERN_ADMIN_TOKEN) [ -z "$CFG_TOKEN" ] && CFG_TOKEN="$value" ;;
      KERN_TOKEN_FILE) [ -z "$CFG_TOKEN_FILE" ] && CFG_TOKEN_FILE="$value" ;;
      KERN_HOME) [ -z "$CFG_HOME" ] && CFG_HOME="$value" ;;
      KERN_SERVICE) [ -z "$CFG_SERVICE" ] && CFG_SERVICE="$value" ;;
    esac
  done <<CONFIG
$(sed -n 's/^[[:space:]]*\(KERN_[A-Z_]*\)[[:space:]]*=[[:space:]]*"\{0,1\}\([^"]*\)"\{0,1\}[[:space:]]*$/\1=\2/p' "$1")
CONFIG
}

load_config() {
  read_config_file "$USER_CONFIG"
  read_config_file "$SYSTEM_CONFIG"
}

resolve() {
  load_config
  [ -z "$URL" ] && URL="${KERN_URL:-}"
  [ -z "$URL" ] && URL="$CFG_URL"
  [ -z "$URL" ] && URL="$DEFAULT_URL"
  URL="${URL%/}"
  # Accept either the origin or the full API base, so both paste in cleanly.
  case "$URL" in
    */kern/v1) API="$URL" ;;
    *) API="$URL/kern/v1" ;;
  esac
  ADMIN="$API/admin"

  [ -z "$TOKEN" ] && TOKEN="${KERN_ADMIN_TOKEN:-}"
  [ -z "$TOKEN" ] && TOKEN="$CFG_TOKEN"
  if [ -z "$TOKEN" ]; then
    for f in "$CFG_TOKEN_FILE" "${ADMIN_TOKEN_FILE:-}" "$DEFAULT_TOKEN_FILE" "${CFG_HOME:-/opt/kern}/data/kern/admin-token"; do
      [ -n "$f" ] || continue
      [ -r "$f" ] || continue
      TOKEN="$(tr -d ' \t\n\r' < "$f")"
      [ -n "$TOKEN" ] && break
    done
  fi
}

# ---------------------------------------------------------------- the request

no_token() {
  die "No management token.

On the server:        sudo $PROG token new \"$(hostname 2>/dev/null || echo cli)\"
Or pass one:          $PROG --token kern_… status
Or point at a file:   KERN_TOKEN_FILE=/path/to/token in $USER_CONFIG

The server writes a first token to ${ADMIN_TOKEN_FILE:-$DEFAULT_TOKEN_FILE} on
first start, and prints it if it cannot write there." 2
}

# api METHOD PATH [BODY] -> response body on stdout
api() {
  need curl
  [ -n "$TOKEN" ] || no_token
  method="$1"
  path="$2"
  payload="${3:-}"

  tmp="$(mktemp)"
  errfile="$(mktemp)"
  if [ -n "$payload" ]; then
    code="$(curl -sS -o "$tmp" -w '%{http_code}' -X "$method" \
      -H "Authorization: Bearer $TOKEN" -H 'Content-Type: application/json' -H 'Accept: application/json' \
      --max-time 60 --data "$payload" "$ADMIN$path" 2>"$errfile")" || code="000"
  else
    code="$(curl -sS -o "$tmp" -w '%{http_code}' -X "$method" \
      -H "Authorization: Bearer $TOKEN" -H 'Accept: application/json' \
      --max-time 60 "$ADMIN$path" 2>"$errfile")" || code="000"
  fi
  response="$(cat "$tmp")"
  curl_error="$(cat "$errfile")"
  rm -f "$tmp" "$errfile"

  if [ "$code" = "000" ]; then
    die "Can't reach the server at $ADMIN
${curl_error}

Is it running?   $PROG service status
Is it loopback?  ssh -L 8787:127.0.0.1:8787 ${USER:-you}@server" 3
  fi
  if [ "$code" -ge 400 ]; then
    message="$(json_str "$response" message)"
    [ -z "$message" ] && message="The server answered $code."
    die "$message" 1
  fi
  printf '%s' "$response"
}

# Pulls one top-level string out of a JSON object without a parser. Enough for
# error messages and single fields; anything structured goes through python3.
json_str() {
  printf '%s' "$1" | sed -n 's/.*"'"$2"'"[[:space:]]*:[[:space:]]*"\([^"\\]*\(\\.[^"\\]*\)*\)".*/\1/p' | head -1
}

json_num() {
  printf '%s' "$1" | sed -n 's/.*"'"$2"'"[[:space:]]*:[[:space:]]*\(-\{0,1\}[0-9][0-9.]*\).*/\1/p' | head -1
}

json_quote() {
  printf '%s' "$1" | sed -e 's/\\/\\\\/g' -e 's/"/\\"/g' -e 's/^/"/' -e 's/$/"/'
}

urlencode() {
  printf '%s' "$1" | sed -e 's/%/%25/g' -e 's/ /%20/g' -e 's/+/%2B/g' -e 's/&/%26/g' -e 's/#/%23/g' -e 's/?/%3F/g' -e 's|/|%2F|g'
}

# Runs a python3 program with $BODY on its stdin. Falls back to printing the
# JSON, so no command *needs* python3.
#   -I: isolated, so nothing is imported from the working directory.
render() {
  if [ "$JSON" = 1 ] || ! has_python; then
    [ "$JSON" = 1 ] || warn "Install python3 for formatted output, or use --json."
    printf '%s\n' "$BODY"
    return 0
  fi
  printf '%s' "$BODY" | python3 -I -c "$1"
}

confirm() {
  [ "$YES" = 1 ] && return 0
  [ -t 0 ] || die "Refusing to do that without a terminal to ask at. Pass --yes if you mean it." 2
  printf '%b' "${C_WARN}$1${C_OFF}\nType ${C_B}yes${C_OFF} to continue: "
  read -r answer
  [ "$answer" = "yes" ] || die "Left alone." 2
}

# Shared python helpers, prepended to every program that formats a table.
PY_HELPERS=$(cat <<'PYEOF'
import json, sys
D = json.load(sys.stdin)
DIM, BOLD, OK, WARN, ERR, OFF = "\033[2m", "\033[1m", "\033[32m", "\033[33m", "\033[31m", "\033[0m"
def size(n):
    n = float(n)
    for u in ("B", "KB", "MB", "GB", "TB"):
        if n < 1024:
            return ("%d %s" % (n, u)) if u == "B" else ("%.1f %s" % (n, u))
        n /= 1024
    return "%.1f PB" % n
def when(s, length=16):
    return s[:length].replace("T", " ") if s else "-"
def row(label, value, width=14):
    print("  " + label.ljust(width) + " " + str(value))
PYEOF
)

py() {
  printf '%s\n%s' "$PY_HELPERS" "$1"
}

# ---------------------------------------------------------- service handling
#
# An instance is one of two shapes: a docker compose project, or a systemd
# unit. The installer records which one in KERN_SERVICE; otherwise we look.

SERVICE=""
HOME_DIR=""

detect_service() {
  SERVICE="$CFG_SERVICE"
  HOME_DIR="${CFG_HOME:-/opt/kern}"
  if [ -z "$SERVICE" ]; then
    if [ -f "$HOME_DIR/docker-compose.yml" ]; then
      SERVICE="compose"
    elif command -v systemctl >/dev/null 2>&1 && systemctl list-unit-files 2>/dev/null | grep -q '^kern-server\.service'; then
      SERVICE="systemd"
    else
      SERVICE="unknown"
    fi
  fi
}

compose() {
  if command -v docker >/dev/null 2>&1 && docker compose version >/dev/null 2>&1; then
    ( cd "$HOME_DIR" && docker compose "$@" )
  elif command -v docker-compose >/dev/null 2>&1; then
    ( cd "$HOME_DIR" && docker-compose "$@" )
  else
    die "Neither \`docker compose\` nor \`docker-compose\` is installed." 2
  fi
}

service_cmd() {
  detect_service
  action="$1"
  lines="${2:-200}"
  case "$SERVICE" in
    compose)
      case "$action" in
        status) compose ps ;;
        start) compose up -d ;;
        stop) compose stop ;;
        restart) compose restart api ;;
        logs) compose logs --tail "$lines" api ;;
        upgrade) compose up -d --build && say "${C_OK}Rebuilt and restarted.${C_OFF}" ;;
      esac
      ;;
    systemd)
      case "$action" in
        status) systemctl status --no-pager kern-server ;;
        start) systemctl start kern-server ;;
        stop) systemctl stop kern-server ;;
        restart) systemctl restart kern-server ;;
        logs) journalctl -u kern-server -n "$lines" --no-pager ;;
        upgrade) die "Upgrade a systemd install by replacing the files, then: systemctl restart kern-server" 2 ;;
      esac
      ;;
    *)
      die "Can't tell how this server is run. Put KERN_HOME and KERN_SERVICE (compose or systemd) in $USER_CONFIG." 2
      ;;
  esac
}

# --------------------------------------------------------------------- status

cmd_status() {
  BODY="$(api GET /overview)"
  render "$(py '
i, a, s, c = D["instance"], D["accounts"], D["spaces"], D["collaboration"]
st, sh, so, rt = D["streams"], D["shares"], D["storage"], D["realtime"]
def duration(sec):
    sec = int(sec)
    d, sec = divmod(sec, 86400)
    h, sec = divmod(sec, 3600)
    m = sec // 60
    out = ""
    if d: out += "%dd " % d
    if h or d: out += "%dh " % h
    return out + "%dm" % m
print()
print("  " + BOLD + i["name"] + OFF)
print("  " + DIM + i["apiUrl"] + OFF)
print()
row("Version", "%s on node %s (%s)" % (i["version"], i["nodeVersion"], i["platform"]))
row("Uptime", duration(i["uptimeSeconds"]))
row("Registration", i["registration"])
accounts = "%d (%d verified" % (a["total"], a["verified"])
if a["held"]: accounts += ", %d suspended" % a["held"]
if a["newThisWeek"]: accounts += ", %d new this week" % a["newThisWeek"]
accounts += ")"
if a["limit"]: accounts += "   limit %d" % a["limit"]
row("Accounts", accounts)
spaces = "%d personal, %d workspaces" % (s["personal"], s["workspaces"])
if s["deleted"]: spaces += ", %d deleted" % s["deleted"]
row("Spaces", spaces)
row("Records", "{:,} synced, {:,} tombstones".format(s["records"] - s["tombstones"], s["tombstones"]))
row("Sharing", "%d memberships, %d open invitations" % (c["members"], c["openInvites"]))
streams = "%d of %d enabled, %d deliveries today" % (st["enabled"], st["total"], st["deliveriesToday"])
if st["failuresToday"]: streams += ERR + ", %d failed" % st["failuresToday"] + OFF
row("Streams", streams)
row("Publishing", "%d links, %d calendar feeds" % (sh["links"], sh["calendarFeeds"]) if sh["enabled"] else "turned off")
row("Storage", "%s database, %s in %d images" % (size(so["databaseBytes"]), size(so["assetBytes"]), so["assetCount"]))
row("Connected", "%d client(s) in %d space(s)" % (rt.get("connections", 0), rt.get("rooms", 0)))
row("Email", D["mail"]["from"] if D["mail"]["configured"] else WARN + "not configured - codes go to the log" + OFF)
print()
')"
}

# --------------------------------------------------------------------- health

show_fixes() {
  render "$(py '
for r in D["results"]:
    if r.get("failed"):
        print("  " + ERR + "x" + OFF + " " + r["id"] + ": " + r["failed"])
    elif r["done"]:
        print("  " + OK + "+" + OFF + " " + r["id"] + ": " + r["done"])
')"
}

show_health() {
  render "$(py '
marks = {"ok": OK + " ok " + OFF, "warn": WARN + "warn" + OFF, "fail": ERR + "FAIL" + OFF, "skip": DIM + "skip" + OFF}
group = None
for c in D["checks"]:
    if c["group"] != group:
        group = c["group"]
        print()
        print("  " + DIM + group + OFF)
    print("  [" + marks[c["status"]] + "] " + c["title"])
    if c["status"] in ("warn", "fail"):
        print("         " + c["detail"])
        if c.get("fix"):
            print("         " + DIM + "repair:" + OFF + " kernctl health --fix=" + c["id"])
    elif c.get("facts"):
        print("         " + DIM + "  ".join("%s %s" % (k, v) for k, v in c["facts"].items())[:110] + OFF)
print()
failing = [c for c in D["checks"] if c["status"] == "fail"]
looking = [c for c in D["checks"] if c["status"] == "warn"]
if failing:
    print("  " + ERR + "%d failing" % len(failing) + OFF + (", %d to look at" % len(looking) if looking else ""))
elif looking:
    print("  " + WARN + "%d to look at" % len(looking) + OFF)
else:
    print("  " + OK + "All good." + OFF)
print()
')"
}

cmd_health() {
  fix_id=""
  fix_all=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --fix) fix_all=1 ;;
      --fix=*) fix_id="${1#--fix=}" ;;
      *) usage_error "Unexpected argument: $1" ;;
    esac
    shift
  done

  if [ -n "$fix_id" ]; then
    BODY="$(api POST /health/fix "{\"id\":$(json_quote "$fix_id")}")"
    show_fixes
    return 0
  fi
  if [ "$fix_all" = 1 ]; then
    BODY="$(api POST /health/fix '{"all":true}')"
    show_fixes
    say ""
  fi

  BODY="$(api GET /health)"
  status="$(json_str "$BODY" status)"
  show_health
  [ "$status" = "fail" ] && exit 4
  return 0
}

cmd_heal() {
  say "${C_B}Repairing what can be repaired${C_OFF}"
  BODY="$(api POST /health/fix '{"all":true}')"
  show_fixes
  [ "$JSON" = 1 ] && return 0
  say ""
  say "${C_B}Checking again${C_OFF}"
  BODY="$(api GET /health)"
  status="$(json_str "$BODY" status)"
  show_health
  [ "$status" = "fail" ] && exit 4
  return 0
}

# --------------------------------------------------------------------- doctor
#
# The one command that looks at this machine rather than the server. Run it
# when the server won't start, or before reporting a problem.

cmd_doctor() {
  detect_service
  say ""
  say "${C_B}This machine${C_OFF}"
  say "  host           $(hostname 2>/dev/null || echo unknown)"
  say "  kernctl        $VERSION"
  for tool in curl python3 docker pg_dump psql systemctl; do
    path="$(command -v "$tool" 2>/dev/null || true)"
    if [ -n "$path" ]; then
      say "  $(printf '%-14s' "$tool") ${C_OK}$path${C_OFF}"
    else
      say "  $(printf '%-14s' "$tool") ${C_DIM}not installed${C_OFF}"
    fi
  done
  if command -v df >/dev/null 2>&1; then
    disk="$(df -h "${CFG_HOME:-/}" 2>/dev/null | awk 'NR==2 {print $4" free of "$2" on "$6}')"
    [ -n "$disk" ] && say "  disk           $disk"
  fi

  say ""
  say "${C_B}This install${C_OFF}"
  say "  shape          $SERVICE"
  say "  directory      ${CFG_HOME:-${C_DIM}not recorded${C_OFF}}"
  say "  api            $ADMIN"
  if [ -n "$TOKEN" ]; then
    say "  token          ${C_OK}found${C_OFF} ${C_DIM}($(printf '%s' "$TOKEN" | cut -c1-21)…)${C_OFF}"
  else
    say "  token          ${C_ERR}not found${C_OFF} ${C_DIM}(looked in ${ADMIN_TOKEN_FILE:-$DEFAULT_TOKEN_FILE})${C_OFF}"
  fi
  for f in "$USER_CONFIG" "$SYSTEM_CONFIG"; do
    [ -r "$f" ] && say "  config         $f"
  done

  say ""
  say "${C_B}Reaching the server${C_OFF}"
  need curl
  code="$(curl -sS -o /dev/null -w '%{http_code}' --max-time 10 "$API/health" 2>/dev/null || echo 000)"
  if [ "$code" = "200" ]; then
    say "  health         ${C_OK}200${C_OFF}  $API/health"
    inst="$(curl -sS --max-time 10 "$API/instance" 2>/dev/null || true)"
    if [ -n "$inst" ]; then
      say "  instance       $(json_str "$inst" name)"
      say "  protocol       $(json_num "$inst" protocol)"
      say "  registration   $(json_str "$inst" registration)"
    fi
  else
    say "  health         ${C_ERR}$code${C_OFF}  $API/health"
    say ""
    say "  The server isn't answering. Things to try:"
    say "    $PROG service status"
    say "    $PROG service logs"
    say ""
    return 0
  fi

  if [ -n "$TOKEN" ]; then
    say ""
    say "${C_B}Server health${C_OFF}"
    BODY="$(api GET /health)"
    show_health
  fi
}

# ---------------------------------------------------------------------- users

user_id_for() {
  case "$1" in
    *@*)
      found="$(api GET "/users?q=$(urlencode "$1")&limit=5")"
      id="$(printf '%s' "$found" | sed -n 's/.*"id"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' | head -1)"
      [ -n "$id" ] || die "No account here with the address $1." 1
      printf '%s' "$id"
      ;;
    *) printf '%s' "$1" ;;
  esac
}

cmd_users() {
  sub="${1:-list}"
  [ $# -gt 0 ] && shift
  case "$sub" in
    list)
      q=""
      filter=""
      while [ $# -gt 0 ]; do
        case "$1" in
          -q|--search) q="${2:?-q needs something to search for}"; shift ;;
          --held|--suspended) filter="held" ;;
          --unverified) filter="unverified" ;;
          *) usage_error "Unexpected argument: $1" ;;
        esac
        shift
      done
      BODY="$(api GET "/users?q=$(urlencode "$q")&filter=$filter&limit=200")"
      render "$(py '
us = D["users"]
if not us:
    print("  No accounts match.")
    raise SystemExit
w = min(max(len(u["email"]) for u in us), 40)
print()
print("  " + "EMAIL".ljust(w) + "  SPACES  SESSIONS  STATE")
for u in us:
    state = "suspended" if u["held"] else ("unverified" if not u["emailVerified"] else "")
    colour = ERR if u["held"] else (WARN if not u["emailVerified"] else "")
    print("  " + u["email"][:w].ljust(w) + "  %6d  %8d  %s%s%s" % (u["spaces"], u["activeSessions"], colour, state, OFF if colour else ""))
print()
print("  %d of %d accounts" % (len(us), D["total"]))
print()
')"
      ;;
    show)
      [ $# -ge 1 ] || usage_error "Which account? $PROG users show <email|id>"
      BODY="$(api GET "/users/$(user_id_for "$1")")"
      render "$(py '
u = D["user"]
print()
print("  " + BOLD + (u["name"] or "(no name)") + OFF + "  <" + u["email"] + ">")
print("  " + DIM + u["id"] + OFF)
print()
row("Joined", when(u["createdAt"], 10))
row("Email", "verified" if u["emailVerified"] else WARN + "not verified" + OFF)
row("State", (ERR + "suspended" + OFF + ": " + (u["holdReason"] or "no reason given")) if u["held"] else "active")
row("Sessions", "%d active" % u["activeSessions"])
if D["spaces"]:
    print()
    print("  " + DIM + "spaces" + OFF)
    for s in D["spaces"]:
        print("    %-7s %-10s %s" % (s["role"], s["kind"], s["name"]))
        print("    " + DIM + "%d records, %d member(s)   %s" % (s["records"], s["members"], s["id"]) + OFF)
if D["sessions"]:
    print()
    print("  " + DIM + "sessions" + OFF)
    for s in D["sessions"]:
        print("    %s  %-16s %s" % (when(s["createdAt"]), s["ip"] or "-", (s["client"] or "")[:46]))
print()
')"
      ;;
    hold|suspend)
      [ $# -ge 1 ] || usage_error "Which account? $PROG users hold <email> [reason]"
      who="$1"; shift
      id="$(user_id_for "$who")"
      BODY="$(api POST "/users/$id/hold" "{\"reason\":$(json_quote "${*:-}")}")"
      [ "$JSON" = 1 ] && { printf '%s\n' "$BODY"; return 0; }
      say "${C_OK}Suspended $who.${C_OFF} Their sessions are gone and their sockets closed; their data is untouched."
      ;;
    release|unsuspend)
      [ $# -ge 1 ] || usage_error "Which account? $PROG users release <email>"
      BODY="$(api DELETE "/users/$(user_id_for "$1")/hold")"
      [ "$JSON" = 1 ] && { printf '%s\n' "$BODY"; return 0; }
      say "${C_OK}$1 can sign in again.${C_OFF}"
      ;;
    verify)
      [ $# -ge 1 ] || usage_error "Which account? $PROG users verify <email>"
      BODY="$(api POST "/users/$(user_id_for "$1")/verify" '{}')"
      [ "$JSON" = 1 ] && { printf '%s\n' "$BODY"; return 0; }
      say "${C_OK}$1 is marked verified.${C_OFF} ${C_DIM}Useful on an instance with no SMTP.${C_OFF}"
      ;;
    revoke-sessions)
      [ $# -ge 1 ] || usage_error "Which account? $PROG users revoke-sessions <email>"
      BODY="$(api POST "/users/$(user_id_for "$1")/sessions/revoke" '{}')"
      [ "$JSON" = 1 ] && { printf '%s\n' "$BODY"; return 0; }
      say "${C_OK}Signed $1 out everywhere${C_OFF} ($(json_num "$BODY" revoked) session(s))."
      ;;
    delete)
      [ $# -ge 1 ] || usage_error "Which account? $PROG users delete <email> [--with-workspaces]"
      who="$1"; shift
      extra=""
      [ "${1:-}" = "--with-workspaces" ] && extra="?withWorkspaces=true"
      id="$(user_id_for "$who")"
      confirm "This deletes $who, their personal space and every workspace they own. It cannot be undone."
      BODY="$(api DELETE "/users/$id$extra" "{\"confirm\":$(json_quote "$who")}")"
      [ "$JSON" = 1 ] && { printf '%s\n' "$BODY"; return 0; }
      say "${C_OK}Deleted $who${C_OFF} and $(json_num "$BODY" spacesRemoved) space(s)."
      ;;
    *) usage_error "Unknown: users $sub" ;;
  esac
}

# ----------------------------------------------------------------- allow list

cmd_allow() {
  sub="${1:-list}"
  [ $# -gt 0 ] && shift
  case "$sub" in
    list)
      BODY="$(api GET /allow)"
      render "$(py '
print()
row("Registration", D["registration"])
print()
if not D["allowed"]:
    print("  Nobody is pre-authorised.")
    if D["registration"] == "invite":
        print("  " + DIM + "In invite mode, people need a workspace invitation, or an entry here." + OFF)
else:
    for a in D["allowed"]:
        used = ("used " + when(a["usedAt"], 10)) if a["usedAt"] else "unused"
        print("  %-34s %-12s %s" % (a["email"], used, a["note"]))
print()
')"
      ;;
    add)
      [ $# -ge 1 ] || usage_error "Which address? $PROG allow add <email> [note]"
      email="$1"; shift
      BODY="$(api POST /allow "{\"email\":$(json_quote "$email"),\"note\":$(json_quote "${*:-}")}")"
      [ "$JSON" = 1 ] && { printf '%s\n' "$BODY"; return 0; }
      say "${C_OK}$email may now sign up.${C_OFF}"
      ;;
    remove|rm)
      [ $# -ge 1 ] || usage_error "Which address? $PROG allow remove <email>"
      BODY="$(api DELETE "/allow/$(urlencode "$1")")"
      [ "$JSON" = 1 ] && { printf '%s\n' "$BODY"; return 0; }
      say "${C_OK}Removed $1.${C_OFF} ${C_DIM}An account they already made is unaffected.${C_OFF}"
      ;;
    *) usage_error "Unknown: allow $sub" ;;
  esac
}

# --------------------------------------------------------------------- spaces

cmd_spaces() {
  sub="${1:-list}"
  [ $# -gt 0 ] && shift
  case "$sub" in
    list)
      q=""; kind=""; deleted=""
      while [ $# -gt 0 ]; do
        case "$1" in
          -q|--search) q="${2:?-q needs something to search for}"; shift ;;
          --personal) kind="personal" ;;
          --workspaces) kind="workspace" ;;
          --deleted) deleted="true" ;;
          *) usage_error "Unexpected argument: $1" ;;
        esac
        shift
      done
      BODY="$(api GET "/spaces?q=$(urlencode "$q")&kind=$kind&deleted=$deleted&limit=200")"
      render "$(py '
ss = D["spaces"]
if not ss:
    print("  No spaces match.")
    raise SystemExit
w = min(max(len(s["name"]) for s in ss), 30)
print()
print("  " + "NAME".ljust(w + 1) + " KIND       MEMBERS  RECORDS  IMAGES  OWNER")
for s in ss:
    mark = "*" if s["deletedAt"] else " "
    print("  " + s["name"][:w].ljust(w) + mark + " %-10s %7d  %7d  %6s  %s"
          % (s["kind"], s["members"], s["records"], size(s["assetBytes"]), s["owner"]["email"]))
    print("  " + DIM + " " * (w + 1) + " " + s["id"] + OFF)
print()
print("  %d space(s)" % len(ss) + ("    * deleted" if any(s["deletedAt"] for s in ss) else ""))
print()
')"
      ;;
    show)
      [ $# -ge 1 ] || usage_error "Which space? $PROG spaces show <id>"
      BODY="$(api GET "/spaces/$1")"
      render "$(py '
s = D["space"]
print()
print("  " + BOLD + s["name"] + OFF + "  " + DIM + "(" + s["kind"] + ")" + OFF)
print("  " + DIM + s["id"] + OFF)
print()
row("Created", when(s["createdAt"], 10))
row("Change head", s["head"])
if s["deletedAt"]:
    row("Deleted", when(s["deletedAt"], 10))
print()
print("  " + DIM + "members" + OFF)
for m in D["members"]:
    print("    %-7s %s" % (m["role"], m["email"]))
if D["tables"]:
    print()
    print("  " + DIM + "records by table" + OFF)
    for t in D["tables"]:
        extra = "  (+%d deleted)" % t["tombstones"] if t["tombstones"] else ""
        print("    %-24s %7d%s" % (t["table"], t["records"], extra))
print()
')"
      ;;
    delete)
      [ $# -ge 1 ] || usage_error "Which space? $PROG spaces delete <id> [--purge]"
      id="$1"; shift
      purge=""
      [ "${1:-}" = "--purge" ] && purge="?purge=true"
      detail="$(api GET "/spaces/$id")"
      name="$(json_str "$detail" name)"
      if [ -n "$purge" ]; then
        confirm "This permanently removes \"$name\" and everything in it."
      else
        confirm "This marks \"$name\" deleted for everyone in it."
      fi
      BODY="$(api DELETE "/spaces/$id$purge" "{\"confirm\":$(json_quote "$name")}")"
      [ "$JSON" = 1 ] && { printf '%s\n' "$BODY"; return 0; }
      if [ -n "$purge" ]; then
        say "${C_OK}\"$name\" is gone.${C_OFF}"
      else
        say "${C_OK}\"$name\" is marked deleted.${C_OFF} ${C_DIM}Purge it with --purge, or let \`$PROG heal\` clear it after 30 days.${C_OFF}"
      fi
      ;;
    *) usage_error "Unknown: spaces $sub" ;;
  esac
}

