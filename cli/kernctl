# ------------------------------------------------------------------ dispatch

CMD=""
while [ $# -gt 0 ]; do
  case "$1" in
    --url) URL="${2:?--url needs an address}"; shift ;;
    --token) TOKEN="${2:?--token needs a token}"; shift ;;
    --json) JSON=1 ;;
    --yes|-y) YES=1 ;;
    --quiet) QUIET=1 ;;
    -h|--help) CMD="help"; break ;;
    -V|--version) CMD="version"; break ;;
    -*) usage_error "Unknown option: $1" ;;
    *) CMD="$1"; shift; break ;;
  esac
  shift
done

[ -z "$CMD" ] && { cmd_help; exit 0; }

case "$CMD" in
  help|version) ;;
  *) resolve ;;
esac

case "$CMD" in
  status) cmd_status "$@" ;;
  health|check) cmd_health "$@" ;;
  heal|repair) cmd_heal "$@" ;;
  doctor) cmd_doctor "$@" ;;
  users|user) cmd_users "$@" ;;
  allow) cmd_allow "$@" ;;
  spaces|space) cmd_spaces "$@" ;;
  invites|invite) cmd_invites "$@" ;;
  streams|stream) cmd_streams "$@" ;;
  settings) cmd_settings "$@" ;;
  set) cmd_set "$@" ;;
  token|tokens) cmd_token "$@" ;;
  pair) cmd_pair "$@" ;;
  logs|log) cmd_logs "$@" ;;
  audit) cmd_audit "$@" ;;
  notice) cmd_notice "$@" ;;
  query|sql) cmd_query "$@" ;;
  backup) cmd_backup "$@" ;;
  restore) cmd_restore "$@" ;;
  service)
    [ $# -ge 1 ] || usage_error "service what? status, start, stop, restart, logs, upgrade"
    action="$1"; shift
    case "$action" in
      status|start|stop|restart|logs|upgrade) service_cmd "$action" "${1:-200}" ;;
      *) usage_error "Unknown: service $action" ;;
    esac
    ;;
  use) cmd_use "$@" ;;
  version) cmd_version ;;
  help) cmd_help ;;
  *) usage_error "Unknown command: $CMD" ;;
esac
