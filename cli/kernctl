show_logs() {
  render "$(py '
colour = {"info": "", "warn": WARN, "error": ERR}
for l in D["lines"]:
    print(DIM + l["at"][11:19] + OFF + " " + colour[l["level"]] + l["text"] + OFF)
')"
}

cmd_logs() {
  follow=0; level=""; limit=200
  while [ $# -gt 0 ]; do
    case "$1" in
      -f|--follow) follow=1 ;;
      --level) level="${2:?--level needs warn or error}"; shift ;;
      -n|--lines) limit="${2:?-n needs a number}"; shift ;;
      *) usage_error "Unexpected argument: $1" ;;
    esac
    shift
  done
  since=0
  while :; do
    BODY="$(api GET "/logs?since=$since&limit=$limit&level=$level")"
    if [ "$JSON" = 1 ]; then
      printf '%s\n' "$BODY"
      return 0
    fi
    show_logs
    [ "$follow" = 1 ] || break
    latest="$(json_num "$BODY" latest)"
    since="${latest:-$since}"
    limit=200
    sleep 2
  done
}

