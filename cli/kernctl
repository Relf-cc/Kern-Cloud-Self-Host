# -------------------------------------------------------------------- settings

cmd_settings() {
  BODY="$(api GET /settings)"
  render "$(py '
print()
print("  " + BOLD + "Changeable here" + OFF + DIM + "   kernctl set <key> <value>" + OFF)
print()
for k, v in D["settings"].items():
    value = v["value"]
    if isinstance(value, bool): value = "yes" if value else "no"
    elif isinstance(value, list): value = ", ".join(value) or DIM + "(any)" + OFF
    elif value == "": value = DIM + "(none)" + OFF
    source = "" if v["source"] == "stored" else DIM + "  from .env" + OFF
    print("  %-22s %s%s" % (k, value, source))
e = D["environment"]
print()
print("  " + BOLD + "From .env" + OFF + DIM + "   needs a restart to change" + OFF)
print()
mail = ("%s:%d as %s" % (e["mail"]["host"], e["mail"]["port"], e["mail"]["from"])) if e["mail"]["configured"] else WARN + "not configured" + OFF
inbound = (e["inboundEmail"]["domain"] or "on") if e["inboundEmail"]["enabled"] else DIM + "off" + OFF
reach = "loopback only" if e["admin"]["localOnly"] else "loopback and " + (", ".join(e["admin"]["allowFrom"]) or WARN + "nothing" + OFF)
for k, v in [
    ("publicUrl", e["publicUrl"]),
    ("apiUrl", e["apiUrl"]),
    ("appScheme", e["appScheme"] + "://"),
    ("listening", "%s:%d" % (e["host"], e["port"])),
    ("mail", mail),
    ("inboundEmail", inbound),
    ("management", reach),
    ("streamsKey", "set" if e["streamsKeySet"] else WARN + "derived from the session secret" + OFF),
    ("inviteExpiry", "%d days" % e["inviteDays"]),
]:
    print("  %-22s %s" % (k, v))
print()
')"
}

cmd_set() {
  [ $# -ge 2 ] || usage_error "$PROG set <key> <value>
Keys: $PROG settings    Value \"default\" falls back to .env"
  key="$1"; shift
  value="$*"
  if [ "$value" = "default" ]; then
    payload="{\"$key\":null}"
  else
    case "$key" in
      maxUsers)
        case "$value" in
          ''|*[!0-9]*) usage_error "maxUsers takes a whole number (0 for no limit)." ;;
        esac
        payload="{\"$key\":$value}"
        ;;
      sharesEnabled)
        case "$value" in
          true|yes|on|1) payload="{\"$key\":true}" ;;
          false|no|off|0) payload="{\"$key\":false}" ;;
          *) usage_error "sharesEnabled takes yes or no." ;;
        esac
        ;;
      *) payload="{\"$key\":$(json_quote "$value")}" ;;
    esac
  fi
  BODY="$(api PATCH /settings "$payload")"
  [ "$JSON" = 1 ] && { printf '%s\n' "$BODY"; return 0; }
  if [ "$value" = "default" ]; then
    say "${C_OK}$key follows .env again.${C_OFF}"
  else
    say "${C_OK}$key is now $value.${C_OFF}"
  fi
  case "$key" in
    registration) say "${C_DIM}Apps see this on their sign-in screen straight away.${C_OFF}" ;;
    instanceName) say "${C_DIM}Emails and invite pages use the new name from the next one sent.${C_OFF}" ;;
  esac
}

