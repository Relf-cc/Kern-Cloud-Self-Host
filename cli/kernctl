# ----------------------------------------------------------------------- pair
#
# Hands Kern Platform everything it needs in one paste.

cmd_pair() {
  name="${1:-Kern Platform}"
  BODY="$(api POST /tokens "{\"name\":$(json_quote "$name"),\"scope\":\"full\",\"days\":null}")"
  token="$(json_str "$BODY" token)"
  ping="$(api GET /ping)"
  instance="$(json_str "$ping" instance)"

  if [ "$JSON" = 1 ]; then
    printf '{"url":"%s","token":"%s","instance":"%s"}\n' "$API" "$token" "$instance"
    return 0
  fi

  code=""
  if has_python; then
    code="$(printf '{"url":"%s","token":"%s","name":"%s"}' "$API" "$token" "$instance" |
      python3 -I -c 'import base64,sys; print("kern-platform:" + base64.urlsafe_b64encode(sys.stdin.buffer.read()).decode().rstrip("="))')"
  fi

  say ""
  say "  ${C_B}$instance${C_OFF} is ready to manage."
  say ""
  say "  Server    ${C_B}$API${C_OFF}"
  say "  Token     ${C_B}$token${C_OFF}"
  if [ -n "$code" ]; then
    say ""
    say "  Or paste this single line into Kern Platform:"
    say ""
    say "  ${C_B}$code${C_OFF}"
  fi
  say ""
  say "  ${C_DIM}The token is shown once. If this server listens on loopback only,"
  say "  forward the port first:  ssh -L 8787:127.0.0.1:8787 ${USER:-you}@$(hostname 2>/dev/null || echo server)${C_OFF}"
  say ""
}

