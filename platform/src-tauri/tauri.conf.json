{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Kern Platform",
  "version": "0.0.3",
  "identifier": "app.kern.platform",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1425",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Kern Platform",
        "width": 1240,
        "height": 820,
        "minWidth": 860,
        "minHeight": 560,
        "center": true,
        "visible": false,
        "backgroundColor": "#111111"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "DeveloperTool",
    "shortDescription": "Manage a self-hosted Kern server",
    "longDescription": "Kern Platform is the administrator's side of a self-hosted Kern server: accounts, workspaces, streams, health checks and repairs, over a loopback connection to the machine the server runs on.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "linux": {
      "deb": {
        "depends": []
      }
    }
  }
}
